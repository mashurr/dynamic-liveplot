{
  "name": "dynamic-liveplot",
  "displayName": "Dynamic Liveplot",
  "description": "Plot any data file, live or static, with any chart type.",
  "version": "0.0.1",
  "publisher": "mashurr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mashurr/dynamic-liveplot.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:dynamicLiveplot.folder"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "dynamicLiveplot.file",
        "displayName": "Dynamic Liveplot",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.sqlite3"
          },
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "dynamicLiveplot.open",
        "title": "Open in Dynamic Liveplot",
        "category": "Dynamic Liveplot",
        "icon": "$(graph-line)"
      },
      {
        "command": "dynamicLiveplot.watchFolder",
        "title": "Watch Folder in Dynamic Liveplot",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.addPlot",
        "title": "Add Plot",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.autoPlot",
        "title": "Auto-plot Again",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.togglePause",
        "title": "Pause or Resume Updates",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.toggleColumns",
        "title": "Show or Hide the Column List",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.changeChartType",
        "title": "Change Chart Type\u2026",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.editBindings",
        "title": "Edit Bindings\u2026",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.export",
        "title": "Export\u2026",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.linkZoom",
        "title": "Link or Unlink Zoom Across Plots",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.openAsText",
        "title": "Open File as Text",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.reveal",
        "title": "Reveal File in Explorer",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.watchParent",
        "title": "Watch This File's Folder",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.openCurrentFile",
        "title": "Open the Current File on Its Own",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.switchFile",
        "title": "Open Another Data File\u2026",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.applyLayout",
        "title": "Apply Layout",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.saveLayoutAs",
        "title": "Save Layout As\u2026",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.saveFolderLayout",
        "title": "Save as Folder Layout",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.loadLayout",
        "title": "Load Layout\u2026",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.applyLayoutFile",
        "title": "Apply Layout",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.revealView",
        "title": "Show View",
        "category": "Dynamic Liveplot"
      },
      {
        "command": "dynamicLiveplot.openLayoutFile",
        "title": "Open Layout File",
        "category": "Dynamic Liveplot"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dynamicLiveplot.open",
          "when": "resourceExtname =~ /^\\.(csv|tsv|jsonl|ndjson|json|sqlite|sqlite3|db|parquet|xlsx)$/ && activeCustomEditorId != 'dynamicLiveplot.file'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "dynamicLiveplot.open",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(csv|tsv|jsonl|ndjson|json|sqlite|sqlite3|db|parquet|xlsx)$/",
          "group": "navigation@9"
        },
        {
          "command": "dynamicLiveplot.watchFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "dynamicLiveplot.watchParent",
          "when": "false"
        },
        {
          "command": "dynamicLiveplot.reveal",
          "when": "false"
        },
        {
          "command": "dynamicLiveplot.openCurrentFile",
          "when": "false"
        },
        {
          "command": "dynamicLiveplot.openAsText",
          "when": "false"
        },
        {
          "command": "dynamicLiveplot.switchFile",
          "when": "false"
        },
        {
          "command": "dynamicLiveplot.linkZoom",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.addPlot",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.editBindings",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.export",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.togglePause",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.changeChartType",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.autoPlot",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.toggleColumns",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.applyLayout",
          "when": "false"
        },
        {
          "command": "dynamicLiveplot.saveLayoutAs",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.saveFolderLayout",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.loadLayout",
          "when": "dynamicLiveplot.active"
        },
        {
          "command": "dynamicLiveplot.applyLayoutFile",
          "when": "false"
        },
        {
          "command": "dynamicLiveplot.revealView",
          "when": "false"
        },
        {
          "command": "dynamicLiveplot.openLayoutFile",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "dynamicLiveplot.openLayoutFile",
          "when": "view == dynamicLiveplot.layouts && viewItem == layout",
          "group": "navigation"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "*.liveplot.json",
          ".liveplot.json"
        ],
        "url": "./schemas/liveplot.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dynamicLiveplot",
          "title": "Dynamic Liveplot",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "dynamicLiveplot": [
        {
          "id": "dynamicLiveplot.views",
          "name": "Open Views"
        },
        {
          "id": "dynamicLiveplot.layouts",
          "name": "Saved Layouts"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dynamicLiveplot.views",
        "contents": "Plot a data file, live or static.\n[Open Data File](command:dynamicLiveplot.open)\n[Watch Folder](command:dynamicLiveplot.watchFolder)\nWatching a folder plots its newest file and switches when a new one appears."
      },
      {
        "view": "dynamicLiveplot.layouts",
        "contents": "Save a view's layout with Save Layout As\u2026 in its Layout menu, or Save as Folder Layout to share it with everyone who opens that folder."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "compile": "npm run typecheck && node esbuild.mjs",
    "typecheck": "tsc -p . && tsc -p webview",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src webview"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.90.0",
    "echarts": "^6.1.0",
    "echarts-gl": "^2.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.1",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "sql.js": "^1.14.2",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "world-atlas": "^2.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
